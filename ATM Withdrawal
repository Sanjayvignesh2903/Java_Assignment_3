import java.io.File;
import java.io.FileNotFoundException;
import java.util.InputMismatchException;
import java.util.Scanner;

public class ATMSimulation {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        double balance = 500.00;
        
        try {
            // Simulating card reader file
            File cardFile = new File("card_data.txt");
            Scanner fileScanner = new Scanner(cardFile); // Can throw FileNotFoundException
            
            System.out.print("Enter account number: ");
            int accountNum = scanner.nextInt(); // Can throw InputMismatchException
            
            System.out.print("Enter withdrawal amount: ");
            double amount = scanner.nextDouble(); // Can throw InputMismatchException
            
            if (amount < 0) {
                throw new IllegalArgumentException("Cannot withdraw a negative amount.");
            }
            if (amount > balance) {
                throw new IllegalArgumentException("Insufficient funds.");
            }
            
            balance -= amount;
            System.out.println("Please take your cash. Remaining balance: " + balance);
            
        } catch (FileNotFoundException e) {
            System.out.println("Hardware Error: Card reader file missing.");
        } catch (InputMismatchException | IllegalArgumentException e) {
            // Multi-catch block 
            System.out.println("Input Error: Invalid input provided. " + e.getMessage());
        } catch (Exception e) {
            System.out.println("System Error: An unexpected error occurred.");
        } finally {
            System.out.println("Transaction ended. Please remove your card.");
            scanner.close();
        }
    }
}
