import java.io.IOException;

// 1. Exception Hierarchy
class ExamException extends Exception {
    ExamException(String message) { super(message); }
    ExamException(String message, Throwable cause) { super(message, cause); }
}

class SubmissionStorageException extends ExamException {
    SubmissionStorageException(String message, Throwable cause) { super(message, cause); }
}

class WindowClosedException extends ExamException {
    WindowClosedException(String message) { super(message); }
}

class NotRegisteredException extends ExamException {
    NotRegisteredException(String message) { super(message); }
}

// 2. Storage Layer
class StorageLayer {
    void save(String fileName, long sizeKb) throws SubmissionStorageException {
        try {
            if (sizeKb > 500) throw new IOException("Disk quota exceeded");
            System.out.println("Saved " + fileName);
        } catch (IOException e) {
            // Exception Chaining
            throw new SubmissionStorageException("Could not store " + fileName, e);
        }
    }
}

// 3. Service Layer
class ServiceLayer {
    StorageLayer storage = new StorageLayer();
    
    void processSubmission(String studentId, String fileName, long sizeKb, boolean isWindowOpen, boolean isRegistered) throws ExamException {
        if (!isWindowOpen) throw new WindowClosedException("The exam window has closed.");
        if (!isRegistered) throw new NotRegisteredException("Student " + studentId + " is not registered.");
        
        // Propagates SubmissionStorageException upwards
        storage.save(fileName, sizeKb); 
    }
}

// 4. Controller Layer
public class ControllerLayer {
    public static void main(String[] args) {
        ServiceLayer service = new ServiceLayer();
        
        try {
            service.processSubmission("192324061", "answer02.pdf", 800, true, true);
        } catch (ExamException e) {
            System.out.println("Upload Failed: " + e.getMessage());
            if (e.getCause() != null) {
                System.out.println("Original Cause: " + e.getCause().getMessage());
            }
        }
    }
}
